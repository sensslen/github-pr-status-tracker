<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the README screenshots from the app's real views over made-up data, headless, so taking them
       never touches a running instance, its data folder or anyone's actual pull requests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PrStatusTracker\PrStatusTracker.csproj" />
  </ItemGroup>
</Project>
